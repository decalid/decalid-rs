{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'decalid-rs'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=decalid-rs",
                    "--package=decalid-rs"
                ],
                "filter": {
                    "name": "decalid-rs",
                    "kind": "bin"
                }
            },
            "args": ["show-calendar", "-c", "1", "-s", "2023-11-01T00:00:00Z", "-e", "2023-12-18T00:00:00Z"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'decalid-rs'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=decalid-rs",
                    "--package=decalid-rs"
                ],
                "filter": {
                    "name": "decalid-rs",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}